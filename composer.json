{
	"name": "sglogger/wp-security-center",
	"description": "Security monitoring and alerting for WordPress: plugin/theme changes, administrator and role changes, configuration changes, filesystem integrity and geo-aware login control.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Steven Glogger",
			"homepage": "https://www.glogger.ch"
		}
	],
	"require": {
		"php": ">=8.1",
		"ext-json": "*",
		"bacon/bacon-qr-code": "^3.0",
		"maxmind-db/reader": "^1.11"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/php-compatibility": "^9.3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"classmap": [
			"includes/",
			"admin/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"WPSecurityCenter\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"fix": "phpcbf"
	}
}
