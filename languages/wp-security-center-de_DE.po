msgid "WP Security Center"
msgstr ""

#. Plugin URI of the plugin
#: wp-security-center.php
msgid "https://github.com/sglogger/wp-security-center"
msgstr ""

#. Description of the plugin
#: wp-security-center.php
msgid "Security monitoring and alerting for WordPress. Logs and alerts on plugin/theme changes, administrator and role changes, configuration changes, filesystem integrity and logins from countries outside your allow list — with optional login blocking. Administrator-only, with immediate e-mail alerts."
msgstr "Sicherheitsüberwachung und Alarmierung für WordPress. Protokolliert und meldet Änderungen an Plugins und Themes, an Administratoren und Rollen, an der Konfiguration und am Dateibestand sowie Logins aus Ländern ausserhalb deiner Positivliste — mit optionaler Login-Sperre. Nur für Administratoren sichtbar, mit sofortigen E-Mail-Alarmen."

#. Author of the plugin
#: wp-security-center.php
msgid "Steven Glogger"
msgstr ""

#. Author URI of the plugin
#: wp-security-center.php
msgid "https://www.glogger.ch"
msgstr ""

