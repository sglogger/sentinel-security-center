<?xml version="1.0"?>
<ruleset name="WP Security Center">
	<description>WordPress coding standards for WP Security Center.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/local_wp_core/*</exclude-pattern>
	<exclude-pattern>/db_data/*</exclude-pattern>
	<exclude-pattern>/steven/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra">
		<!-- Files are class-kebab-case.php holding Underscore_Case classes,
			 the WordPress core convention. The sniff expects one or the other
			 to be renamed; we follow core, not PSR-4. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

		<!-- Short array syntax is the house style and is used consistently
			 across this author's plugins. WPCS 3 defaults to long arrays. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="wp-security-center"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="wpsec,WPSEC,WPSecurityCenter"/>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="8.1-"/>

	<!-- Deliberate deviations, each for a reason rather than convenience.

		 DisallowShortTernary: `?:` is used throughout for "value or fallback"
		 and reads better than repeating the expression.

		 NoSilencedErrors / AlternativeFunctions: the scanners and the GeoIP
		 downloader touch the filesystem directly and on purpose. WP_Filesystem
		 is not initialised during cron, which is exactly when these run, and a
		 file vanishing mid-scan is normal rather than exceptional — it must not
		 raise a warning into someone\'s error log.

		 UnusedFunctionParameter: hook callbacks have to match the signature
		 WordPress passes, whether or not every argument is needed.

		 NoReservedKeywordParameterNames: same reason — the names come from the
		 core hook signatures.

		 MissingTranslatorsComment in class-mailer.php: that file holds one flat
		 table of event descriptions where %1$s is always the object or affected
		 user and %2$s always the acting user. The rule is documented once on the
		 method rather than repeated fifty times. -->
	<rule ref="Universal.Operators.DisallowShortTernary">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/includes/scanners/*</exclude-pattern>
		<exclude-pattern>/includes/geo/class-geoip-database.php</exclude-pattern>
		<exclude-pattern>/includes/geo/class-tar-reader.php</exclude-pattern>
		<exclude-pattern>/includes/class-installer.php</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.I18n.MissingTranslatorsComment">
		<exclude-pattern>/includes/class-mailer.php</exclude-pattern>
	</rule>

	<!-- Custom-table SQL.

		 Every query in these files follows the same shape: the table name is
		 built from $wpdb->prefix (a table name cannot be a placeholder, so it
		 has to be interpolated) while every VALUE goes through prepare(). The
		 sniff cannot tell the two apart, and inline ignores do not survive
		 multi-line statements, so the exemption is recorded here instead —
		 narrowed to the files that own those tables.

		 If you add a query to one of these files, the rule still stands: table
		 name interpolated, values bound. Never interpolate a value. -->
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>/includes/class-log-query.php</exclude-pattern>
		<exclude-pattern>/includes/class-logger.php</exclude-pattern>
		<exclude-pattern>/includes/scanners/class-file-scanner.php</exclude-pattern>
		<exclude-pattern>/includes/scanners/class-config-scanner.php</exclude-pattern>
	</rule>

	<!-- The exporter streams to php://output, which WP_Filesystem cannot do. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/admin/class-csv-exporter.php</exclude-pattern>
	</rule>

	<!-- Config_Scanner and Hardening read core state: xmlrpc_enabled is a core
		 filter, not a hook of ours, and var_export renders a constant that may
		 be bool or string for comparison rather than for debugging. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>/includes/scanners/class-config-scanner.php</exclude-pattern>
		<exclude-pattern>/includes/class-hardening.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions.error_log_var_export">
		<exclude-pattern>/includes/scanners/class-config-scanner.php</exclude-pattern>
	</rule>

	<!-- Logger warns loudly about an unregistered event type, but only ever
		 under WP_DEBUG. -->
	<rule ref="WordPress.PHP.DevelopmentFunctions.error_log_trigger_error">
		<exclude-pattern>/includes/class-logger.php</exclude-pattern>
	</rule>

	<!-- In templates, whitespace inside tags such as <textarea> is significant.
		 These sniffs reformat embedded PHP onto its own lines, which silently
		 injects newlines into field values, so they are off for the views. -->
	<rule ref="Squiz.PHP.EmbeddedPhp">
		<exclude-pattern>/admin/views/*</exclude-pattern>
	</rule>
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<exclude-pattern>/admin/views/*</exclude-pattern>
	</rule>

	<!-- The unit tests are plain PHP against WordPress-free classes; the
		 WordPress file/naming conventions do not apply to them. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
